@using Blazor.Heroicons.Solid
@inject IJSRuntime JS
@inherits LayoutComponentBase

<header class="w-full bg-slate-400 dark:bg-slate-700">
    <div class="container max-w-4xl mx-auto p-2 flex items-center justify-between">
        <div class="flex flex-gap ml-2 gap-x-4 font-bold">
            <button @onclick="ScrollToTop"
                    class="transition-colors duration-200 px-3 py-1 rounded hover:bg-slate-300 hover:text-slate-900 dark:hover:bg-slate-600 dark:hover:text-slate-100">
                Home
            </button>
            <button @onclick="ScrollToAbout"
                    class="transition-colors duration-200 px-3 py-1 rounded hover:bg-slate-300 hover:text-slate-900 dark:hover:bg-slate-600 dark:hover:text-slate-100">
                About
            </button>
            <button @onclick="ScrollToProfileSkills"
                    class="transition-colors duration-200 px-3 py-1 rounded hover:bg-slate-300 hover:text-slate-900 dark:hover:bg-slate-600 dark:hover:text-slate-100">
                Skills
            </button>
        </div>
        <div class="mr-2">
            <button @onclick="ChangeTheme" class="bg-slate-500 dark:bg-slate-600 rounded-md hover:bg-slate-600 dark:hover:bg-slate-500 px-1 py-1">
                @if (theme == true)
                {
                    <SunIcon class="h-6 w-6 text-slate-300" />
                }
                else
                {
                    <MoonIcon class="h-6 w-6 text-slate-300" />
                }
            </button>
        </div>
    </div>
</header>

         
@inherits LayoutComponentBase

@if (theme.HasValue)
{
    <div class="min-h-screen flex flex-col bg-slate-200 dark:bg-gray-800 text-slate-900 dark:text-slate-300">
        <!-- Hero Section: fills viewport -->
        <section class="w-full h-screen flex flex-col items-center justify-center bg-gradient-to-b from-slate-300 to-slate-200 dark:from-gray-900 dark:to-gray-800">
            <h1 class="text-4xl md:text-6xl font-bold mb-4 text-center">
                Hi, I'm Roger. <br />
                I'm a full stack web developer.
            </h1>
        </section>

        <!-- Sticky Nav: initially out of view, sticks when scrolled to top -->
        <div class="sticky top-0 z-30">
            <NavMenu theme="(bool)theme" ChangeTheme="ChangeTheme" />
        </div>

        <div class="flex-grow container max-w-4xl mx-auto flex flex-col text-slate-900 dark:text-slate-300">
            <main class="flex-grow w-full bg-slate-200 dark:bg-gray-800 pt-1 md:p-3 pb-0">
                <div class="rounded-md bg-slate-300 dark:bg-gray-900 p-4 w-full h-full">
                    @Body
                </div>
            </main>
            <Footer />
        </div>
    </div>
}

@inherits LayoutComponentBase

@if (theme.HasValue)
{
    <div id="top" class="min-h-screen flex flex-col bg-slate-200 dark:bg-gray-800 text-slate-900 dark:text-slate-300">
        <!-- Hero Section: fills viewport -->
        <section class="relative w-full h-screen flex flex-col items-center justify-center">
            <canvas class="background absolute inset-0 w-full h-full z-0"></canvas>
            <h1 class="text-4xl md:text-6xl font-bold mb-4 text-center relative z-10">
                Hi, I'm Roger. <br />
                I'm a full stack web developer.
            </h1>
        </section>

        <!-- Sticky Nav: initially out of view, sticks when scrolled to top -->
        <div class="sticky top-0 z-30">
            <NavMenu theme="(bool)theme" ChangeTheme="ChangeTheme" />
        </div>

        <div class="flex-grow container max-w-4xl mx-auto flex flex-col text-slate-900 dark:text-slate-300">
            <main class="flex-grow w-full pt-1 md:p-3 pb-0">
                <div id ="about" class="rounded-md bg-slate-300 dark:bg-slate-900 p-4 w-full h-full">
                    @Body
                </div>
            </main>
            <Footer />
        </div>
    </div>
}

@using Blazor.Heroicons.Solid
@page "/"

<!-- Profile and Skills section anchor for About -->
<div class="min-h-screen flex flex-col items-center text-center pt-8 px-5">
    <div class="relative w-44 h-44 rounded-full overflow-hidden border-4 border-slate-500 dark:border-slate-700 mb-5">
        <img src="images/self.jpg"
             alt="Roger Marquis"
             class="absolute inset-0 w-48 h-48 object-cover" />
    </div>
    <p class="mt-2 max-w-2xl">
        Full stack software engineer with a passion for building web applications.
        I am motivated by challenging projects and continuous learning, and have a professional background building internal and external web apps for Gallup.
        Proficient in various technologies including Java, .NET, Blazor, JavaScript frameworks, and Databases.
    </p>
    <div id="skills" class="w-full max-w-4xl px-4 mt-8">
        <h2 class="text-2xl font-bold mb-6 text-slate-700 dark:text-slate-200">Skills and Technologies</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6 mt-8">
            <div class="flex flex-col items-center bg-slate-200 dark:bg-slate-800 rounded-xl shadow-md p-4 hover:scale-105 transition-transform duration-200">
                <img src="./images/blazor.png" alt="Blazor" class="w-12 h-12 mb-2" />
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-200">BLAZOR</div>
            </div>
            <div class="flex flex-col items-center bg-slate-200 dark:bg-slate-800 rounded-xl shadow-md p-4 hover:scale-105 transition-transform duration-200">
                <img src="./images/dotnet.png" alt="Blazor" class="w-12 h-12 mb-2" />
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-200">.NET</div>
            </div>
            <div class="flex flex-col items-center bg-slate-200 dark:bg-slate-800 rounded-xl shadow-md p-4 hover:scale-105 transition-transform duration-200">
                <img src="./images/java.png" alt="Java" class="w-12 h-12 mb-2" />
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-200">JAVA</div>
            </div>
            <div class="flex flex-col items-center bg-slate-200 dark:bg-slate-800 rounded-xl shadow-md p-4 hover:scale-105 transition-transform duration-200">
                <img src="./images/oracle.png" alt="Oracle" class="w-12 h-12 mb-2" />
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-200">ORACLE</div>
            </div>
            <div class="flex flex-col items-center bg-slate-200 dark:bg-slate-800 rounded-xl shadow-md p-4 hover:scale-105 transition-transform duration-200">
                <img src="./images/js.png" alt="Javascript" class="w-12 h-12 mb-2" />
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-200">JAVASCRIPT</div>
            </div>
            <div class="flex flex-col items-center bg-slate-200 dark:bg-slate-800 rounded-xl shadow-md p-4 hover:scale-105 transition-transform duration-200">
                <img src="./images/react.png" alt="React" class="w-12 h-12 mb-2" />
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-200">REACT</div>
            </div>
            <div class="flex flex-col items-center bg-slate-200 dark:bg-slate-800 rounded-xl shadow-md p-4 hover:scale-105 transition-transform duration-200">
                <img src="./images/html.png" alt="HTML" class="w-12 h-12 mb-2" />
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-200">HTML</div>
            </div>
            <div class="flex flex-col items-center bg-slate-200 dark:bg-slate-800 rounded-xl shadow-md p-4 hover:scale-105 transition-transform duration-200">
                <img src="./images/css.png" alt="CSS" class="w-12 h-12 mb-2" />
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-200">CSS</div>
            </div>
            <div class="flex flex-col items-center bg-slate-200 dark:bg-slate-800 rounded-xl shadow-md p-4 hover:scale-105 transition-transform duration-200">
                <img src="./images/sass.png" alt="Sass" class="w-12 h-12 mb-2" />
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-200">SASS</div>
            </div>
            <div class="flex flex-col items-center bg-slate-200 dark:bg-slate-800 rounded-xl shadow-md p-4 hover:scale-105 transition-transform duration-200">
                <img src="./images/less.png" alt="Less" class="w-12 h-12 mb-2" />
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-200">LESS</div>
            </div>
            <div class="flex flex-col items-center bg-slate-200 dark:bg-slate-800 rounded-xl shadow-md p-4 hover:scale-105 transition-transform duration-200">
                <img src="./images/sql.png" alt="sql" class="w-12 h-12 mb-2" />
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-200">SQL</div>
            </div>
            <div class="flex flex-col items-center bg-slate-200 dark:bg-slate-800 rounded-xl shadow-md p-4 hover:scale-105 transition-transform duration-200">
                <img src="./images/git.png" alt="Git" class="w-12 h-12 mb-2" />
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-200">GIT</div>
            </div>
        </div>
    </div>
</div>